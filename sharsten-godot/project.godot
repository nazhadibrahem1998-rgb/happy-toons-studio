; Engine configuration file.
config_version=5

[application]

config/name="Sharsten"
config/description="Part 1. A dream of an old mountain village."
run/main_scene="res://scenes/boot.tscn"
config/version="1.0.0"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

ContentDB="*res://scripts/autoload/content_db.gd"
Settings="*res://scripts/autoload/settings.gd"
GameState="*res://scripts/autoload/game_state.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/min_width=1280
window/size/min_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[debug]

gdscript/warnings/inference_on_variant=0
gdscript/warnings/untyped_declaration=0
gdscript/warnings/unused_variable=0
gdscript/warnings/unused_signal=0

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.web="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.55, 0.62, 0.72, 1)
