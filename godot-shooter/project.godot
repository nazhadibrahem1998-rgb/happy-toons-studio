; Engine configuration file.
config_version=5

[application]

config/name="Untitled Kurdish Shooter"
config/description="Third-person demo. Placeholder title, Sorani UI. Hero: Gurut."
config/version="0.2.0"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"

[autoload]

Boot="*res://scripts/autoload/boot.gd"
Settings="*res://scripts/autoload/settings.gd"
LevelManager="*res://scripts/autoload/level_manager.gd"
AudioDirector="*res://scripts/autoload/audio_director.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

